generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// 1. Sesión y Seguridad (Simplificado, sin roles)
model Usuario {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  nombre   String
}

// 2. El Catálogo Estático (Físico)
model Producto {
  id           Int            @id @default(autoincrement())
  nombre       String
  precioBase   Decimal        @db.Decimal(10, 2)
  codigoBarras String         @unique
  categoria    String?
  imagenUrl    String?
  stockMinimo  Int            @default(5)
  // Relaciones
  lotes        Lote[]
  detalles     DetalleVenta[]
}

// 3. El Inventario Real (Gestión de Mermas y Fechas)
model Lote {
  id                 Int       @id @default(autoincrement())
  productoId         Int
  cantidadDisponible Int
  fechaVencimiento   DateTime? // Opcional, por si venden cosas que no caducan (ej. detergente)
  fechaIngreso       DateTime  @default(now())
  // Relaciones
  producto           Producto  @relation(fields: [productoId], references: [id])
}

// 4. La Cabecera de la Venta (El Ticket)
model Venta {
  id         Int            @id @default(autoincrement())
  fechaHora  DateTime       @default(now())
  totalVenta Decimal        @db.Decimal(10, 2)
  metodoPago String         // Guardará "Efectivo" o "Yape"
  // Relaciones
  detalles   DetalleVenta[]
}

// 5. El Detalle (Inmutabilidad Histórica)
model DetalleVenta {
  id                      Int      @id @default(autoincrement())
  ventaId                 Int
  productoId              Int
  cantidadVendida         Int
  precioUnitarioCongelado Decimal  @db.Decimal(10, 2)
  // Relaciones
  venta                   Venta    @relation(fields: [ventaId], references: [id])
  producto                Producto @relation(fields: [productoId], references: [id])
}

// 6. Auditoría y Logs (Automático)
model Movimiento {
  id          Int      @id @default(autoincrement())
  tipo        String   // Ej: "INGRESO_LOTE", "VENTA", "MERMA"
  descripcion String   // Ej: "Ingresaron 10x Oreo", "Venta Ticket #4"
  fecha       DateTime @default(now())
}